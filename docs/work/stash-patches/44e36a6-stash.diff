+                        &w.word,
+                        &w.ipa,
+                        w.rarity,
+                        lexical::is_closed_class(&w.word),
+                        w.ipa.chars().count(),
+                        w.sub_cost,
+                    );
+                }
+                let m = p.metrics(&tb, ts, tl, false);
+                let ws: Vec<String> = p
+                    .words
+                    .iter()
+                    .map(|w| {
+                        format!(
+                            "{}|{}",
+                            w.word,
+                            w.rarity
+                                .map(|r| format!("{r:.0}"))
+                                .unwrap_or("-".into())
+                        )
+                    })
+                    .collect();
+                println!(
+                    "POOL {:.9}|{:.9}|{:.9}|{:.9}|{:.9}|{:.9}|{:.9}|{}|{}",
+                    axes::SIMILARITY * (1.0 - p.sub_cost_total / 4.0).clamp(0.0, 1.0),
+                    axes::NOVELTY * m.novelty,
+                    axes::WORD_NOVELTY * m.word_novelty,
+                    axes::FAMILIARITY * (p.familiarity_sum / p.words.len().max(1) as f64),
+                    axes::RHYTHM * m.rhythm,
+                    axes::SHAPE * (p.shape_sum / p.words.len().max(1) as f64),
+                    axes::CLOSED_CLASS
+                        * closed_class_penalty(
+                            p.closed as f64,
+                            p.words.len().max(1) as f64,
+                        ),
+                    c.phrase.replace(' ', "_"),
+                    ws.join(" "),
+                );
+            }
+        }
+    }
