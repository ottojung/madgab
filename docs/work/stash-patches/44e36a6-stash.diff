+/// `mm`, `ad`, `p`, `pa` -- are all of them.  Nearly every
+/// two-letter English token is already a function word, so this mostly
+/// reinforces the closed-class test, but it needs no word list to do it.
+///
+/// It replaces `lexical_shape_quality`, which asked the same question
+/// and got it wrong: it was a step function that scored a one-letter `a`
+/// at 1.0, exactly as high as a seven-letter `justice`, and it did that
+/// for a fifth of the score.  Over the 2000 best candidates of a dozen
+/// real targets its range was 0.010-0.030, so it could not separate
+/// anything anyway.
+fn answer_word_quality(word: &str) -> f64 {
+    // The closed-class test lowercases and trims, so the letter count is
+    // taken over the same characters it sees, counted in place rather than
+    // by materialising a normalized string.
+    let mut letters = 0usize;
+    for c in word.chars() {
+        if c.is_alphanumeric() {
+            letters += 1;
+        }
+    }
+    match letters {
+        0 | 1 => 0.0,
+        2 => 0.4,
+        3 => 0.85,
+        _ => 1.0,
+    }
+}
