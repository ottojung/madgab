+#[cfg(test)]
+mod probe_tests {
+    use super::*;
+
+    #[test]
+    fn probe_dump_structure() {
+        let g = Generator::from_json(
+            open_english_pronouncing_dictionary::CORPUS_JSON,
+            GeneratorConfig {
+                mode: SearchMode::approximate(),
+                top_n: 50,
+                ..GeneratorConfig::default()
+            },
+        )
+        .unwrap();
+        super::probe::want(&["hits", "justice", "dupe", "hid", "came"]);
+        let (clues, pool) = g.generate_with_pool("It's just a stupid game");
+        let mut log = super::probe::dump();
+        let census = super::probe::CENSUS.with(|c| c.borrow().clone()).unwrap_or_default();
+        let mut costs = super::probe::BUILT.with(|b| b.borrow().clone());
+        costs.sort_by(|a, b| a.partial_cmp(b).unwrap());
+        let rej = super::probe::REJECTED.with(|r| *r.borrow());
+        log.push(census);
+        log.push(format!("emissions_built={} rejected_over_budget={} cost_min={:.6} cost_p50={:.6} cost_p99={:.6} cost_max={:.6}",
+            costs.len(), rej, costs[0], costs[costs.len()/2], costs[costs.len()*99/100], costs[costs.len()-1]));
+        let mut all = log.clone();
+        all.push(format!("pool={pool} shown={}", clues.len()));
+        all.push(format!("emissions_over_target_cost={}", costs.iter().filter(|c| **c <= 1.11951981416578961).count()));
+        let mut per = super::probe::PER.with(|p| p.borrow().clone());
+        per.sort_by_key(|(_, c)| std::cmp::Reverse(c.len()));
+        for (k, c) in per.iter().filter(|(k,_)| *k == vec![(0usize,3usize),(3,10),(10,13),(13,15),(15,19)]) {
+            all.push(format!("per-structure {k:?} emissions={} cost_min={:.6} cost_max={:.6}", c.len(), c.iter().cloned().fold(f64::MAX, f64::min), c.iter().cloned().fold(f64::MIN, f64::max)));
+        }
+        all.push(format!("structures_emitted={}", per.len()));
+        std::fs::write("/tmp/opencode/1c3e77/probe.txt", all.join("\n")).unwrap();
+    }
