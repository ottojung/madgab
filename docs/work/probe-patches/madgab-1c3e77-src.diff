+#[cfg(test)]
+pub mod probe {
+    use std::cell::RefCell;
+
+    pub struct Context {
+        pub structure: Vec<(usize, usize)>,
+        pub widths: Vec<usize>,
+        pub words: Vec<Vec<String>>,
+        pub phase: usize,
+    }
+
+    thread_local! {
+        pub static LOG: RefCell<Vec<String>> = const { RefCell::new(Vec::new()) };
+        pub static WANT: RefCell<Vec<String>> = const { RefCell::new(Vec::new()) };
+        pub static BUILT: RefCell<Vec<f64>> = const { RefCell::new(Vec::new()) };
+        pub static REJECTED: RefCell<usize> = const { RefCell::new(0) };
+        pub static CENSUS: RefCell<Option<String>> = const { RefCell::new(None) };
+        pub static PER: RefCell<Vec<(Vec<(usize, usize)>, Vec<f64>)>> = const { RefCell::new(Vec::new()) };
+    }
+
+    pub fn built(structure: &[(usize, usize)], cost: f64) {
+        BUILT.with(|b| b.borrow_mut().push(cost));
+        PER.with(|p| {
+            let mut v = p.borrow_mut();
+            let key = structure.to_vec();
+            match v.iter_mut().find(|(k, _)| *k == key) {
+                Some((_, costs)) => costs.push(cost),
+                None => v.push((key, vec![cost])),
+            }
+        });
+    }
+
+    pub fn rejected() {
+        REJECTED.with(|r| *r.borrow_mut() += 1);
+    }
+
+    /// Once, for the first segmentation of the wanted structure: how many
+    /// tuples of this structure are cost-admissible at or below the wanted
+    /// wording's total cost, and where the wanted coordinate sits in that
+    /// cost order.
+    pub fn census(ctx: &Context, costs: &[Vec<f64>]) {
+        if CENSUS.with(|c| c.borrow().is_some()) {
+            return;
+        }
+        let want = WANT.with(|w| w.borrow().clone());
+        if want.is_empty() || want.len() != ctx.widths.len() {
+            return;
+        }
+        let mut ranks = Vec::new();
+        for (slot, w) in want.iter().enumerate() {
+            match ctx.words[slot].iter().position(|x| x == w) {
+                Some(r) => ranks.push(r),
+                None => return,
+            }
+        }
+        let target_cost: f64 =
+            ranks.iter().enumerate().map(|(s, &i)| costs[s][i]).sum();
+        // Count every tuple of the structure at or below the target's cost,
+        // by walking the three widest slots and binary-searching the fourth.
+        // The slots' own lists are ordered by contribution, not by cost, so
+        // the searched list is sorted here.
+        let mut fourth = costs[4].clone();
+        fourth.sort_by(|a, b| a.partial_cmp(b).unwrap());
+        let mut total = 0f64;
+        let mut strictly_lower = 0f64;
+        for a in 0..costs[0].len() {
+            for b in 0..costs[2].len() {
+                for c in 0..costs[3].len() {
+                    let base = costs[0][a] + costs[2][b] + costs[3][c];
+                    let room = target_cost - base;
+                    if room < 0.0 {
+                        continue;
+                    }
+                    let (le, lt) = partition_point(&fourth, room);
+                    total += le as f64;
+                    strictly_lower += lt as f64;
+                }
+            }
+        }
+        let width1 = costs[1].len() as f64;
+        CENSUS.with(|c| {
+            *c.borrow_mut() = Some(format!(
+                "census struct={:?} widths={:?} ranks={:?} target_cost={:.17} \
+                 tuples_at_or_below={} tuples_strictly_below={}",
+                ctx.structure, ctx.widths, ranks, target_cost,
+                (total * width1) as u64, (strictly_lower * width1) as u64
+            ))
+        });
+    }
+
+    fn partition_point(sorted: &[f64], x: f64) -> (usize, usize) {
+        let mut lo = 0usize;
+        let mut hi = sorted.len();
+        while lo < hi {
+            let mid = (lo + hi) / 2;
+            if sorted[mid] <= x {
+                lo = mid + 1;
+            } else {
+                hi = mid;
+            }
+        }
+        let le = lo;
+        let mut lo2 = 0usize;
+        let mut hi2 = sorted.len();
+        while lo2 < hi2 {
+            let mid = (lo2 + hi2) / 2;
+            if sorted[mid] < x {
+                lo2 = mid + 1;
+            } else {
+                hi2 = mid;
+            }
+        }
+        (le, lo2)
+    }
+
+    pub fn want(words: &[&str]) {
+        WANT.with(|w| {
+            *w.borrow_mut() = words.iter().map(|s| s.to_string()).collect();
+        });
+        LOG.with(|l| l.borrow_mut().clear());
+    }
+
+    pub fn dump() -> Vec<String> {
+        LOG.with(|l| l.borrow().clone())
+    }
+
+    pub fn offer(ctx: &Context, tuple: &[usize]) {
+        let want = WANT.with(|w| w.borrow().clone());
+        if want.is_empty() || want.len() != ctx.widths.len() {
+            return;
+        }
+        let mut line = String::new();
+        let mut ranks = Vec::new();
+        for (slot, w) in want.iter().enumerate() {
+            let r = ctx.words[slot].iter().position(|x| x == w);
+            ranks.push(r);
+            line.push_str(&format!(
+                " slot{slot}:width={} rank={:?}",
+                ctx.widths[slot], r
+            ));
+        }
+        let depth = tuple.iter().filter(|&&i| i != 0).count();
+        let exact = ranks
+            .iter()
+            .enumerate()
+            .all(|(i, r)| r.map(|r| tuple[i] == r).unwrap_or(false));
+        if exact {
+            line.push_str(" <<< EXACT REQUESTED TUPLE");
+        }
+        LOG.with(|l| {
+            l.borrow_mut().push(format!(
+                "struct={:?} phase={} tuple={:?} depth={}{}",
+                ctx.structure, ctx.phase, tuple, depth, line
+            ));
+        });
+    }
+}
