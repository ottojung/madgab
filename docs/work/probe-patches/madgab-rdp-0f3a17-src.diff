+/// w-9e2b41 re-derivation probe, part 5: the price of the tuple itself.
+///
+/// For every retained segmentation that carries a whole wording, the
+/// cheapest per-slot width vector that *contains* that wording is exactly
+/// `(i_k + 1)` — you cannot be narrower than the index you must reach.  So
+/// the joint cost of the tuple is not a free parameter: it is
+/// `first_leaf(i+1)`, the product of the prefix widths below the deep
+/// coordinate.  Priced against the per-segmentation pop limit.
+#[cfg(test)]
+mod rdp_price {
+    use super::*;
+    use crate::seg_dump::{self, limits};
+
+    fn first_leaf(a: &[u64]) -> u128 {
+        let mut total: u128 = 1;
+        let mut p: u128 = 1;
+        for &w in a.iter().take(a.len().saturating_sub(1)) {
+            p *= w as u128;
+            total += p;
+        }
+        total
+    }
+
+    fn all_nodes(a: &[u64]) -> u128 {
+        let mut total: u128 = 0;
+        let mut p: u128 = 1;
+        for &w in a.iter() {
+            p *= w as u128;
+            total += p;
+        }
+        first_leaf(a) + total
+    }
+
+    #[test]
+    fn rdp_price_of_the_tuple() {
+        let cases: Vec<Vec<String>> = std::fs::read_to_string(
+            "/workspace/rdp-0f3a17-cases.tsv",
+        )
+        .unwrap()
+        .lines()
+        .map(str::trim)
+        .filter(|l| !l.is_empty())
+        .map(|l| l.split('\t').map(str::to_string).collect())
+        .collect();
+        let g = Generator::from_json(
+            open_english_pronouncing_dictionary::CORPUS_JSON,
+            GeneratorConfig {
+                mode: SearchMode::approximate(),
+                top_n: 50,
+                ..GeneratorConfig::default()
+            },
+        )
+        .unwrap();
+        for case in &cases {
+            let target = &case[0];
+            let wording: Vec<String> = case[1..].to_vec();
+            let w = wording.len();
+            seg_dump::arm();
+            let _ = g.generate_pool(target);
+            let segs = seg_dump::take();
+            let (pop, _, _, emit_allow) = limits();
+            println!("== {target:?} {:?}  (pop limit {pop}, emission allowance {emit_allow})", wording.join(" "));
+            for s in segs.iter().filter(|s| s.cap > 0) {
+                if s.slots.len() < w {
+                    continue;
+                }
+                for start in 0..=s.slots.len() - w {
+                    if !(0..w).all(|j| s.slots[start + j].contains(&wording[j])) {
+                        continue;
+                    }
+                    let idx: Vec<u64> = (0..w)
+                        .map(|j| {
+                            s.slots[start + j]
+                                .iter()
+                                .position(|x| x == &wording[j])
+                                .unwrap() as u64
+                                + 1
+                        })
+                        .collect();
+                    let (fl, an) = (first_leaf(&idx), all_nodes(&idx));
+                    // `first_leaf` is 1 + w_0 + w_0 w_1 + ... + w_0..w_{d-2}:
+                    // the last slot's width does not appear in it at all, and
+                    // every earlier slot's is multiplied by the prefix above
+                    // it.  So the binding coordinate is the one with the
+                    // largest prefix product, i.e. the deepest slot whose
+                    // width is already paid for by everything above it.
+                    let mut p: u64 = 1;
+                    let mut binding = (0usize, 0u64, 1u64);
+                    for (k, &v) in idx.iter().enumerate().take(idx.len() - 1) {
+                        p = p.saturating_mul(v);
+                        if p >= binding.2 {
+                            binding = (k, v, p);
+                        }
+                    }
+                    println!(
+                        "   d={} cap={} indices(i)={:?} min-widths(i+1)={:?} \
+                         first_leaf={fl} ({:.2}x limit) all_nodes={an} ({:.1}x limit) \
+                         binding slot {binding:?} (slot, min width, prefix product) \
+                         measured pops {} ({:.1}% of limit) emitted {} ({:.0}% of allowance) \
+                         affordable={}",
+                        s.depth,
+                        s.cap,
+                        idx.iter().map(|x| x - 1).collect::<Vec<_>>(),
+                        idx,
+                        fl as f64 / pop as f64,
+                        an as f64 / pop as f64,
+                        s.popped,
+                        s.popped as f64 / pop as f64 * 100.0,
+                        s.emitted,
+                        s.emitted as f64 / emit_allow as f64 * 100.0,
+                        fl <= pop as u128,
+                    );
+                    break;
+                }
+            }
+        }
+    }
+}
