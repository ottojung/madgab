+    /// ---- deliverable 2 and 3: the canonical alignment's per-slot
+    /// traversal indices, per depth, and the 237-of-240 question ----
+    #[test]
+    fn rdp_canonical_slot_indices() {
+        let cases: Vec<Vec<String>> = std::fs::read_to_string(CASES)
+            .unwrap()
+            .lines()
+            .map(str::trim)
+            .filter(|l| !l.is_empty())
+            .map(|l| l.split('\t').map(str::to_string).collect())
+            .collect();
+        let g = Generator::from_json(
+            open_english_pronouncing_dictionary::CORPUS_JSON,
+            GeneratorConfig {
+                mode: SearchMode::approximate(),
+                top_n: 50,
+                ..GeneratorConfig::default()
+            },
+        )
+        .unwrap();
+
+        for case in &cases {
+            let target = &case[0];
+            let wording: Vec<String> = case[1..].to_vec();
+            seg_dump::arm();
+            let _pool = g.generate_pool(target);
+            let segs: Vec<Seg> = seg_dump::take();
+            let w = wording.len();
+            println!("== target {target:?} wording {wording:?}");
+            println!("   retained segmentations: {}", segs.len());
+
+            // How many segmentations carry the whole wording as a
+            // consecutive run of slots, and in which orders the words sit.
+            let mut carried: Vec<(usize, Vec<usize>, Vec<usize>)> = Vec::new();
+            let mut words_seen_total: HashMap<String, usize> = HashMap::new();
+            let mut words_missing: HashMap<String, usize> = HashMap::new();
+            for s in segs.iter().filter(|s| s.cap > 0) {
+                let mut found = 0;
+                for word in &wording {
+                    if s.slots.iter().any(|l| l.contains(word)) {
+                        *words_seen_total.entry(word.clone()).or_default() += 1;
+                        found += 1;
+                    } else {
+                        *words_missing.entry(word.clone()).or_default() += 1;
+                    }
+                }
+                if found == w && s.slots.len() >= w {
+                    for start in 0..=(s.slots.len() - w) {
+                        let hit = (0..w).all(|j| s.slots[start + j].contains(&wording[j]));
+                        if hit {
+                            let trav: Vec<usize> = (0..w)
+                                .map(|j| s.slots[start + j].iter().position(|x| x == &wording[j]).unwrap())
+                                .collect();
+                            let short: Vec<usize> = trav.clone();
+                            carried.push((s.depth, trav, short));
+                            break;
+                        }
+                    }
+                }
+            }
+            let n = segs.iter().filter(|s| s.cap > 0).count();
+            println!("   segmentations carrying the whole run: {} of {n}", carried.len());
+            for word in &wording {
+                println!(
+                    "     word {word:?}: on some slot of {}/{} segmentations, absent from {}",
+                    words_seen_total.get(word).copied().unwrap_or(0),
+                    n,
+                    words_missing.get(word).copied().unwrap_or(0),
+                );
+            }
+            for (d, trav, _) in &carried {
+                println!("     depth {d}: traversal indices {trav:?}");
+            }
+            // Per depth: every segmentation at that depth, and whether the
+            // run is present, plus the binding slot.
+            println!("   per depth:");
+            for d in 2..=8usize {
+                let at: Vec<&Seg> = segs.iter().filter(|s| s.cap > 0 && s.depth == d).collect();
+                if at.is_empty() { continue; }
+                let cap = at[0].cap;
+                let here: Vec<&(usize, Vec<usize>, Vec<usize>)> =
+                    carried.iter().filter(|(dd, _, _)| *dd == d).collect();
+                let best = here
+                    .iter()
+                    .map(|(_, t, _)| t.iter().copied().max().unwrap_or(0))
+                    .max();
+                let pushable = here.iter().filter(|(_, t, _)| t.iter().all(|&i| i < cap)).count();
+                println!(
+                    "     depth {d}: {} segmentations cap {cap} widest {} run-present {} \
+                     min-needed-width {} of {} pushes need width > cap",
+                    at.len(),
+                    at[0].widest,
+                    here.len(),
+                    best.map(|b| b + 1).unwrap_or(0),
+                    pushable,
+                );
+            }
+        }
+    }
