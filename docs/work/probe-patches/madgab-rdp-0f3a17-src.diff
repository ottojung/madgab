+/// w-9e2b41 re-derivation probe, part 4: why 237 of 240, and whether the
+/// clue is in the lattice at all.
+///
+/// `N_W * N_W` over the 240 retained segmentations of one target: for each
+/// segmentation, which of the wording's words appears on *some* slot (the
+/// word is a real candidate somewhere in that segmentation) and, for the
+/// segmentations that carry the whole run, the run's own spans.  The two
+/// counts separate "this segmentation's boundaries are not the wording's"
+/// from "this word is not a candidate at all", which is the distinction the
+/// two prior fronts each measured half of.
+#[cfg(test)]
+mod rdp_why {
+    use super::*;
+    use crate::seg_dump;
+
+    #[test]
+    fn rdp_why_237_of_240() {
+        let cases: Vec<Vec<String>> = std::fs::read_to_string(
+            "/workspace/rdp-0f3a17-cases.tsv",
+        )
+        .unwrap()
+        .lines()
+        .map(str::trim)
+        .filter(|l| !l.is_empty())
+        .map(|l| l.split('\t').map(str::to_string).collect())
+        .collect();
+        let g = Generator::from_json(
+            open_english_pronouncing_dictionary::CORPUS_JSON,
+            GeneratorConfig {
+                mode: SearchMode::approximate(),
+                top_n: 50,
+                ..GeneratorConfig::default()
+            },
+        )
+        .unwrap();
+        for case in &cases {
+            let target = &case[0];
+            let wording: Vec<String> = case[1..].to_vec();
+            let w = wording.len();
+            seg_dump::arm();
+            let _ = g.generate_pool(target);
+            let segs = seg_dump::take();
+            let live: Vec<_> =
+                segs.iter().filter(|s| s.cap > 0).collect();
+
+            // The wording's own span set, read off any carrier.
+            let mut carrier_spans: Option<Vec<(usize, usize)>> = None;
+            for s in &live {
+                if s.slots.len() < w {
+                    continue;
+                }
+                let hit = (0..=s.slots.len() - w).any(|start| {
+                    (0..w).all(|j| s.slots[start + j].contains(&wording[j]))
+                });
+                if hit {
+                    carrier_spans = Some(s.spans.clone());
+                    println!(
+                        "carrier: depth {} cap {} spans {:?} widths {:?} pops {} emitted {}",
+                        s.depth, s.cap, s.spans, s.widths, s.popped, s.emitted
+                    );
+                    break;
+                }
+            }
+
+            // Per segmentation: how many of the wording's words appear on
+            // some slot, and how many of the wording's OWN spans appear at
+            // all among that segmentation's spans.
+            let mut only_structure = 0usize;
+            let mut some_word_absent = 0usize;
+            for s in &live {
+                let words_here = wording
+                    .iter()
+                    .filter(|x| s.slots.iter().any(|l| l.contains(x)))
+                    .count();
+                if words_here < w {
+                    if words_here == 0 {
+                        some_word_absent += 1;
+                    } else {
+                        only_structure += 1;
+                    }
+                }
+            }
+            let spans_here = carrier_spans
+                .as_ref()
+                .map(|cs| {
+                    live.iter()
+                        .map(|s| cs.iter().filter(|sp| s.spans.contains(sp)).count())
+                        .max()
+                        .unwrap_or(0)
+                })
+                .unwrap_or(0);
+            println!(
+                "== {target:?} {:?}: {}/{} live segmentations; \
+                 partial-word coverage only (boundaries differ) {only_structure}, \
+                 no wording word on any slot {some_word_absent}; \
+                 the carrier's {spans_here} spans present in one segmentation",
+                wording.join(" "),
+                live.len(),
+                segs.len(),
+            );
+        }
+    }
+}
