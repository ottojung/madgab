+/// w-9e2b41 re-derivation probe: one row per retained segmentation.
+///
+/// Records, for every segmentation the approximate traversal considers,
+/// the slot spans, each slot's list **in traversal order** (`slots[k]`, the
+/// order the walk indexes), the opening width `cap` the walk actually opened
+/// at, and the pops and emissions the segmentation spent.  Probe branch
+/// only; compiled out of every non-test build.
+#[cfg(test)]
+mod seg_dump {
+    use std::cell::RefCell;
+
+    /// One retained segmentation, as the traversal saw it.
+    #[derive(Clone, Debug)]
+    pub struct Seg {
+        pub spans: Vec<(usize, usize)>,
+        /// `slots[k]`, in traversal order, whole list (not truncated at cap).
+        pub slots: Vec<Vec<String>>,
+        /// Set when a span had no shortlist edge at all.
+        pub possible: bool,
+        /// The opening width, once it is known (0 before that point).
+        pub cap: usize,
+        pub depth: usize,
+        pub widest: usize,
+        /// The shortlist width of each slot, i.e. `slots[k].len()`.
+        pub widths: Vec<usize>,
+        pub popped: usize,
+        pub emitted: usize,
+    }
+
+    thread_local! {
+        static SEGS: RefCell<Vec<Seg>> = const { RefCell::new(Vec::new()) };
+        static ARMED: RefCell<bool> = const { RefCell::new(false) };
+    }
+
+    /// The two budgets the traversal charges, exported so a probe can price
+    /// a per-slot allocation against them.  Recorded from inside
+    /// `generate_approximate` so the probe cannot drift from production.
+    thread_local! {
+        static LIMITS: RefCell<(usize, usize, usize, usize)> =
+            const { RefCell::new((0, 0, 0, 0)) };
+    }
+
+    pub fn set_limits(
+        pop_limit: usize,
+        global_pop_budget: usize,
+        segmentation_keep: usize,
+        emissions_per_segmentation: usize,
+    ) {
+        LIMITS.with(|l| {
+            *l.borrow_mut() = (
+                pop_limit,
+                global_pop_budget,
+                segmentation_keep,
+                emissions_per_segmentation,
+            )
+        });
+    }
+
+    pub fn limits() -> (usize, usize, usize, usize) {
+        LIMITS.with(|l| *l.borrow())
+    }
+
+    pub fn arm() {
+        SEGS.with(|s| s.borrow_mut().clear());
+        ARMED.with(|a| *a.borrow_mut() = true);
+    }
+
+    pub fn take() -> Vec<Seg> {
+        SEGS.with(|s| std::mem::take(&mut *s.borrow_mut()))
+    }
+
+    fn armed() -> bool {
+        ARMED.with(|a| *a.borrow())
+    }
+
+    /// Called with the segmentation's slots, before the traversal runs.
+    pub fn record_slots(
+        spans: &[(usize, usize)],
+        slots: &[Vec<String>],
+        possible: bool,
+    ) {
+        if !armed() {
+            return;
+        }
+        let depth = spans.len();
+        SEGS.with(|s| {
+            s.borrow_mut().push(Seg {
+                spans: spans.to_vec(),
+                slots: slots.to_vec(),
+                possible,
+                cap: 0,
+                depth,
+                widest: 0,
+                widths: Vec::new(),
+                popped: 0,
+                emitted: 0,
+            })
+        });
+    }
+
+    pub fn record_cap(cap: usize, depth: usize, widest: usize, widths: Vec<usize>) {
+        if !armed() {
+            return;
+        }
+        SEGS.with(|s| {
+            if let Some(seg) = s.borrow_mut().last_mut() {
+                seg.cap = cap;
+                seg.depth = depth;
+                seg.widest = widest;
+                seg.widths = widths;
+            }
+        });
+    }
+
+    pub fn record_spend(popped: usize, emitted: usize) {
+        if !armed() {
+            return;
+        }
+        SEGS.with(|s| {
+            if let Some(seg) = s.borrow_mut().last_mut() {
+                seg.popped = popped;
+                seg.emitted = emitted;
+            }
+        });
+    }
+}
