+/// lives on a scratch branch in its own worktree with its own target dir.
+///
+/// Every phrase comes from a TSV named on the command line, so the probe
+/// holds no target, clue or word of its own.
+#[cfg(test)]
+mod rederive_probe {
+    use super::*;
+    use crate::seg_dump::{self, Seg};
+    use seg_dump::limits;
+    use std::collections::HashMap;
+
+    const CASES: &str = "/workspace/rdp-0f3a17-cases.tsv";
+    const TARGETS: &str = "/workspace/rdp-0f3a17-targets.txt";
+
+    /// The nodes a walk pops before its *first* leaf is reachable:
+    /// the root, then every internal level.  This is the quantity
+    /// `affordable_opening_width`'s `fits` closure computes, generalised
+    /// from a uniform `w` to a per-slot vector.
+    fn first_leaf(a: &[usize]) -> u128 {
+        let mut total: u128 = 1;
+        let mut p: u128 = 1;
+        for &w in a.iter().take(a.len().saturating_sub(1)) {
+            p *= w as u128;
+            total += p;
+        }
+        total
+    }
+
+    /// Every node the lattice has: the internal levels plus the leaf level.
+    /// `popped` in the traversal counts leaves too, so this is the shape of
+    /// the real charge.
+    fn all_nodes(a: &[usize]) -> u128 {
+        let mut total: u128 = 0;
+        let mut p: u128 = 1;
+        for &w in a.iter() {
+            p *= w as u128;
+            total += p;
+        }
+        first_leaf(a) + total
+    }
+
+    /// The production derivation, mirrored.
+    fn affordable(slot_count: usize, pop_limit: usize) -> usize {
+        if slot_count <= 1 {
+            return LEXICAL_BRANCH_STAGE_0;
+        }
+        let mut width = LEXICAL_BRANCH_STAGE_0;
+        while width > 1 && first_leaf(&vec![width; slot_count]) > pop_limit as u128 {
+            width -= 1;
+        }
+        width
+    }
+
+    /// The per-slot MARGINAL table: slot `k` widened, every other slot
+    /// held at the uniform baseline.  This is the table the width front
+    /// published.
+    fn marginal_row(depth: usize, pop_limit: usize, list: usize) -> Vec<usize> {
+        let b = affordable(depth, pop_limit);
+        (0..depth)
+            .map(|k| {
+                let mut a = vec![b; depth];
+                a[k] = 1;
+                (1..=list)
+                    .rev()
+                    .find(|&w| {
+                        a[k] = w;
+                        first_leaf(&a) <= pop_limit as u128
+                    })
+                    .unwrap_or(1)
+            })
+            .collect()
+    }
+
+    /// A JOINTLY legal allocation: slot 0 is opened as wide as it can be
+    /// with the rest at the baseline, then that width is *committed* and
+    /// slot 1 is re-derived against the committed prefix, and so on.  The
+    /// difference from `marginal_row` is the commitment: the marginal
+    /// re-solves each slot in isolation and throws the other slots' answers
+    /// away, so the vector it returns is a set of separate optima, not one
+    /// feasible point.
+    fn joint_greedy(depth: usize, pop_limit: usize, list: usize) -> Vec<usize> {
+        let b = affordable(depth, pop_limit);
+        let mut a = vec![b; depth];
+        for k in 0..depth {
+            let mut best = 1;
+            for w in (1..=list).rev() {
+                a[k] = w;
+                if first_leaf(&a) <= pop_limit as u128 {
+                    best = w;
+                    break;
+                }
+            }
+            a[k] = best;
+        }
+        a
+    }
+
+    /// The uniform baseline's own joint cost, for reference.
+    fn uniform_cost(depth: usize, pop_limit: usize) -> (usize, u128, u128) {
+        let b = affordable(depth, pop_limit);
+        let a = vec![b; depth];
+        (b, first_leaf(&a), all_nodes(&a))
+    }
+
