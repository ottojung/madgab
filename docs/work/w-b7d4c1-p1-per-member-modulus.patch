+    /// **Property (i): a subset's members are indexed in their own spans,
+    /// not in the narrowest member's.**
+    ///
+    /// The reserve draws a deep coordinate per subset member.  A member
+    /// whose own list is wider than its subset's narrowest list must
+    /// therefore be reachable *above* that narrowest width: if every deep
+    /// coordinate of a subset is capped by the narrowest member's span, the
+    /// subset's draws are a function of one member of the subset and the
+    /// rest of the subset's own lists are never covered at all.
+    ///
+    /// The expectation is recomputed here, inline, from the **slot widths**
+    /// and [`LEXICAL_BRANCH_STAGE_0`], deliberately not by calling
+    /// [`sweep_index`] or [`coverage_tuples`] on their own behalf: the
+    /// narrowest width of a subset is arithmetic on the widths, and the
+    /// rule under test is exactly which width is passed where.  No phrase,
+    /// clue or word list appears in the assertion, so this test is a
+    /// property of the *function* and not of any target.
+    ///
+    /// The first clause is the literal per-member legality bound (each
+    /// member's index is inside *its own* list, and above the traversal's
+    /// floor, recomputed from the widths).  That clause holds under a
+    /// shared modulus too and is deliberately not the whole assertion: the
+    /// second clause is the one that is red under it, and without it this
+    /// test would be a statement that a remainder is a remainder.
+    #[test]
+    fn each_sweep_member_is_indexed_in_its_own_slot_width() {
+        // Shapes whose slots are all the same width, and shapes whose widths
+        // differ, so that a subset has a narrowest member and a strictly
+        // wider one and the difference is visible at all.
+        for widths in [
+            vec![SPAN_SHORTLIST; 4],
+            vec![SPAN_SHORTLIST, 93, 40, SPAN_SHORTLIST],
+            vec![12, SPAN_SHORTLIST, SPAN_SHORTLIST, 20, SPAN_SHORTLIST],
+        ] {
+            let max_deep = funded_slot_depth(&widths);
+            // Which subsets the reserve can place at all: every subset of
+            // every funded size, recomputed inline from the widths rather
+            // than read off the production function.  The per-subset
+            // allowance is set to their number so that breadth-before-depth
+            // truncation cannot hide one of them from the property — the
+            // point of the test is the *index* rule, and a subset that was
+            // never funded would say nothing about it.
+            let expected: HashSet<Vec<usize>> = (1..=max_deep)
+                .flat_map(|k| slot_combinations(widths.len(), k))
+                .collect();
+            let per = expected.len();
+            let mut seen: HashSet<Vec<usize>> = HashSet::new();
+            let mut reached_above_narrowest = false;
+            for phase in 0..512usize {
+                for tuple in
+                    coverage_tuples(&widths, per, max_deep, phase, &flat_bound)
+                {
+                    // The members of this tuple's own subset, read off the
+                    // tuple: a slot the reserve kept at the traversal's own
+                    // index is not a member, and a member's index is above
+                    // the floor by the first clause below.
+                    let members: Vec<usize> = tuple
+                        .iter()
+                        .enumerate()
+                        .filter(|&(_, &at)| at != 0)
+                        .map(|(slot, _)| slot)
+                        .collect();
+                    assert!(
+                        !members.is_empty(),
+                        "{tuple:?} is not a coverage draw at all"
+                    );
+                    seen.insert(members.clone());
+                    // Recomputed inline from the widths: the narrowest
+                    // list any member of this subset could be indexed in.
+                    let narrowest = members
+                        .iter()
+                        .map(|&slot| widths[slot])
+                        .min()
+                        .expect("a subset has members");
+                    for &slot in &members {
+                        let at = tuple[slot];
+                        // Recomputed inline: the member's own list, above
+                        // the traversal's own first stage.
+                        assert!(
+                            at >= LEXICAL_BRANCH_STAGE_0 && at < widths[slot],
+                            "slot {slot} of {tuple:?} is outside the part of \
+                             its own list the traversal cannot generate, \
+                             at widths {widths:?}"
+                        );
+                        // The load-bearing clause: some member is indexed at
+                        // or above the subset's narrowest width, so no
+                        // member's draw is confined to another member's
+                        // span.
+                        reached_above_narrowest |= at >= narrowest;
+                    }
+                }
+            }
+            for combo in &expected {
+                assert!(
+                    seen.contains(combo),
+                    "{combo:?} was never placed at any of the 512 phases, so \
+                     'every subset at every phase' is not what was measured \
+                     (widths {widths:?})"
+                );
+            }
+            let ragged = widths.iter().any(|&w| w != *widths.iter().min().unwrap());
+            assert!(
+                !ragged || reached_above_narrowest,
+                "every deep coordinate stayed below the subset's narrowest \
+                 width, so the wider members' own lists are unreachable in \
+                 every phase (widths {widths:?})"
+            );
+        }
+    }
