+    /// **Property (ii): a `k`-deep subset's coordinates are not confined to
+    /// a one-parameter family modulo the members' spans.**
+    ///
+    /// Two coordinates generated by the *same* phase through rates that are
+    /// coprime to their spans are still locked together if they share one
+    /// modulus: then the first is an affine function of the second with a
+    /// shared modulus, and knowing one determines the other, so the subset
+    /// traces a rank-1 curve of the index-tuple space instead of covering
+    /// it.  Concretely: if the second member's coordinate takes a given
+    /// value, the first member's coordinate may not be determined by it (and
+    /// the other way round).
+    ///
+    /// The expectation is again recomputed inline from the **widths** — a
+    /// two-member subset of lists of *different* lengths is the case in
+    /// which a shared modulus is even visible, because with equal spans the
+    /// two claims coincide — and the only functions called are
+    /// [`coverage_tuples`] and [`slot_combinations`], never [`sweep_index`],
+    /// so the assertion cannot be satisfied by the function under test
+    /// agreeing with itself.  No phrase, clue or word list appears.
+    #[test]
+    fn a_deep_subsets_coordinates_are_not_a_one_parameter_family() {
+        // Shapes whose two chosen members have spans of different lengths:
+        // with equal spans "shared modulus" and "each member's own span"
+        // are the same claim and nothing can be told apart.
+        for widths in [
+            vec![SPAN_SHORTLIST, 93],
+            vec![93, SPAN_SHORTLIST],
+            vec![SPAN_SHORTLIST, 40, 93],
+        ] {
+            let depth = widths.len();
+            for combo in slot_combinations(depth, 2) {
+                let (a, b) = (combo[0], combo[1]);
+                // Recomputed inline from the widths: the two members' own
+                // spans above the traversal's floor.  They differ, so a
+                // shared modulus is a claim the widths themselves can
+                // falsify.
+                let span_a = widths[a] - LEXICAL_BRANCH_STAGE_0;
+                let span_b = widths[b] - LEXICAL_BRANCH_STAGE_0;
+                assert_ne!(
+                    span_a, span_b,
+                    "the two members must have spans of different lengths \
+                     for a shared modulus to be visible at all ({widths:?})"
+                );
+                // One *full period of the subset's own draw* — the least
+                // common multiple of the two members' spans, recomputed here
+                // from the widths, so this is a period the widths
+                // themselves determine and not something the sweep reports.
+                // A shared modulus makes the whole subset repeat every
+                // `min(span)` phases, so inside one joint period each of
+                // the narrower member's values is paired with exactly one
+                // value of the wider member's.  Under each member's own
+                // span the narrower member still repeats, and the wider
+                // member's coordinate does not repeat with it.
+                let period = span_a / gcd(span_a, span_b) * span_b;
+                // Which of the two is the narrower one, recomputed from
+                // the widths, so the failure message names the right side.
+                let (narrow, wide) = if span_a < span_b { (a, b) } else { (b, a) };
+                let mut by_narrow: HashMap<usize, HashSet<usize>> = HashMap::new();
+                let mut pairs = 0usize;
+                for phase in 0..period {
+                    for tuple in coverage_tuples(
+                        &widths,
+                        EMIT_PROFILE_RESERVE,
+                        2,
+                        phase,
+                        &flat_bound,
+                    ) {
+                        // Only the draws that made *both* members deep say
+                        // anything about the pair; a tuple that kept one of
+                        // them at the traversal's own index carries no
+                        // second coordinate at all.
+                        if tuple[a] == 0 || tuple[b] == 0 {
+                            continue;
+                        }
+                        pairs += 1;
+                        by_narrow
+                            .entry(tuple[narrow])
+                            .or_default()
+                            .insert(tuple[wide]);
+                    }
+                }
+                assert!(
+                    pairs > 0,
+                    "{combo:?} of {widths:?} never made both members deep in \
+                     {period} phases"
+                );
+                // Keyed by the **narrower** member, which is the direction
+                // that can fail: inside one joint period its coordinate
+                // repeats, and a shared modulus would make the wider
+                // member's repeat with it exactly.  Keyed by the wider
+                // member the map is injective whenever that member's own
+                // period is the joint period, so that direction would be a
+                // statement about the arithmetic of the test rather than
+                // about the rule.
+                assert!(
+                    by_narrow.values().any(|v| v.len() > 1),
+                    "the wider member's coordinate of {combo:?} in {widths:?} \
+                     is a function of the narrower one's, so over one full \
+                     period of the subset's own draw the pair traces a \
+                     one-parameter family instead of a two-parameter support"
+                );
+            }
+        }
+    }
 
