+mod probe_scorer_only {
+    //! SCRATCH-ONLY: is the final scorer a *filter* on the pool, or only an
+    //! order on it?  The `S_*` channel is read by `Partial::metrics` and by
+    //! nothing else, so any difference in the pool's *contents* here is
+    //! evidence that the scorer reaches the search.
+    use super::*;
+    use open_english_pronouncing_dictionary::CORPUS_JSON;
+
+    const TARGETS: &[&str] = &[
+        "I love you", "taco cat", "the cat sat on the mat",
+        "a whole lot of trouble", "she sells sea shells",
+        "big spender", "play games with me now",
+    ];
+
+    #[test]
+    fn probe_scorer_only_invariance() {
