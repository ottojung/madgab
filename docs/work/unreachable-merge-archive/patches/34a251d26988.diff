+            let head: Vec<f64> = rows.iter().take(50).map(|r| r.similarity).collect();
+            let lift = mean(&head) - mean(&all);
+            if lift < 0.0 { red += 1; }
+            println!("  head {t:<26} lift {lift:+.4}");
+        }
+        (red, TARGETS.len())
+    }
+
+    #[test]
+    fn probe_e086cc_sweep() {
+        println!("=== VECTOR sim={} nov={} wnov={} fam={} rhy={} sha={} par={} cpp={} simw={} ceiling={} ===",
+            axes::sim(), axes::novelty(), axes::word_novelty(), axes::familiarity(),
+            axes::rhythm(), axes::shape(), axes::parsimony(), axes::cost_per_phone(),
+            axes::sim_per_word(), axes::positive_sum());
+        let pool_gen = gen(20_000);
+        let f1 = f1_reserve_depth();
+        let (f2, f3, f4) = f2_f3_f4_pool_reach(&pool_gen);
