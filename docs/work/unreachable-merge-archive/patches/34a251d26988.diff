+            all_words.extend(words.iter().cloned());
+            println!("POOLSIGN {t}\t{}\t{}\t{:?}", pool.len(), sigs.len(), &pool[..pool.len().min(3)].iter().map(|c| c.phrase.as_str()).collect::<Vec<_>>());
+        }
+        println!("POOLWORDS_ALL {}", all_words.len());
+    }
