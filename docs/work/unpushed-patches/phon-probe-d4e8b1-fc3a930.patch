+
+    fn report_case(gen: &Generator, target: &str, words: &[&str], pool: &[Clue]) {
+        println!("== {target} :: `{}`", words.join(" "));
+        let p = price(gen, target, words).expect("aligns");
+        let canon = check_terms(&p.clue, target, gen);
+        let cutoff = &pool[49];
+        let cut = check_terms(cutoff, target, gen);
+        let (target_ipa, _, _) = transcribe_with_boundaries(&gen.corpus, target, true).unwrap();
+        let phones = target_ipa.chars().count();
+        println!("phones {phones} total cost {:.10}", p.clue.words.iter().map(|w| w.sub_cost).sum::<f64>());
+        let mut prev = 0usize;
+        for (i, w) in p.clue.words.iter().enumerate() {
+            println!(
+                "  word {} span [{},{}) ipa {} cost {:.10} share of axis {:.10}",
+                w.word, prev, p.cuts[i], w.ipa, w.sub_cost,
+                axes::SIMILARITY * w.sub_cost / phones as f64 / axes::SIMILARITY_COST_PER_PHONE
+            );
+            prev = p.cuts[i];
+        }
+        println!("{:<14} {:>12} {:>14} | {:>12} {:>14} | {:>14}", "term", "canon raw", "canon w", "cut raw", "cut w", "delta");
+        for ((n, ra, wa), (_, rb, wb)) in canon.iter().zip(cut.iter()) {
+            println!("{n:<14} {ra:>12.6} {wa:>14.10} | {rb:>12.6} {wb:>14.10} | {:>+14.10}", wb - wa);
+        }
+        println!("{:<14} {:>12} {:>14.10} | {:>12} {:>14.10} | {:>+14.10}", "TOTAL", "", p.clue.score, "", cutoff.score, cutoff.score - p.clue.score);
+        // The maximum any phonetic-cost rule can reach on this alignment.
+        let perfect = price_with(gen, target, words, &CostModel::AsScored, Some(&p.cuts)).unwrap();
+        let _ = perfect;
+        let ceiling = ceiling_of(gen, target, words, &p.cuts);
+        println!(
+            "perfect-pronunciation ceiling {:.10} (max phonetic gain {:+.10}) residual gap {:.10}",
+            ceiling.0, ceiling.0 - p.clue.score, cutoff.score - ceiling.0
+        );
+        for i in 0..words.len() {
+            let c = ceiling_of_one(gen, target, words, &p.cuts, i);
+            println!(
+                "  free only word {} ({}) ceiling {:.10} gain {:+.10}",
+                i, words[i], c, c - p.clue.score
+            );
+        }
+    }
+
+    /// Rebuild the same alignment with the listed words' cost set to zero: a
+    /// *perfect* pronunciation of the same wording at the same cuts.  No
+    /// phonetic-cost rule can beat this on this alignment.
+    fn ceiling_of(
+        gen: &Generator,
+        target: &str,
+        words: &[&str],
+        cuts: &[usize],
+    ) -> (f64, Vec<f64>) {
+        ceiling_of_one_vec(gen, target, words, cuts, &(0..words.len()).collect::<Vec<_>>())
+    }
+
+    fn ceiling_of_one(
+        gen: &Generator,
+        target: &str,
+        words: &[&str],
+        cuts: &[usize],
+        only: usize,
+    ) -> f64 {
+        ceiling_of_one_vec(gen, target, words, cuts, &[only]).0
+    }
+
+    fn ceiling_of_one_vec(
+        gen: &Generator,
+        target: &str,
+        words: &[&str],
+        cuts: &[usize],
+        free: &[usize],
+    ) -> (f64, Vec<f64>) {
+        let (target_ipa, target_boundaries, target_syllables) =
+            transcribe_with_boundaries(&gen.corpus, target, true).unwrap();
+        let phrase = TargetPhrase::new(target);
+        let chars: Vec<char> = target_ipa.chars().collect();
+        let mut partial = Partial::empty();
+        let mut start = 0usize;
+        let mut costs = Vec::new();
+        for (i, (word, &end)) in words.iter().zip(cuts.iter()).enumerate() {
+            let m = *alternatives(gen, &chars, start, word)
+                .iter()
+                .find(|m| start + m.consumed == end)
+                .expect("pinned span is in the lattice");
+            let (_, w) = alt_of(gen, m);
+            let cost = if free.contains(&i) { 0.0 } else { m.cost };
+            partial = partial.extend_fuzzy(&phrase, &w, end - start, cost);
+            costs.push(cost);
+            start = end;
+        }
+        let clue = partial.into_clue(&target_ipa, &target_boundaries, target_syllables);
+        (clue.score, costs)
+    }
+
+    #[test]
+    #[ignore]
+    fn d4e8b1_term_by_term_both_cases() {
+        let gen = generator(50);
+        let pool = ranked(gen.generate_pool("it's just a stupid game"));
+        let pool1 = ranked(gen.generate_pool("recognize speech"));
+        report_case(&gen, "it's just a stupid game", &CANON_T2, &pool);
+        report_case(&gen, "recognize speech", &GREEN_T1, &pool1);
+    }
