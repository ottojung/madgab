+<body>
+  <main>
+    <h1>madgab</h1>
+    <p class="tagline">
+      Mad Gab puzzle generator in your browser. Type a target phrase, get ranked
+      clue candidates whose pronunciation matches but whose words differ.
+    </p>
+
+    <form id="form">
+      <label class="field">
+        <span>Target phrase</span>
+        <input id="target" type="text" value="It's just a stupid game"
+               placeholder="e.g. It's just a stupid game" autocomplete="off" />
+      </label>
+
+      <div class="row">
+        <label class="field">
+          <span>Mode</span>
+          <select id="mode">
+            <option value="exact" selected>Exact</option>
+            <option value="approximate">Approximate</option>
+          </select>
+        </label>
+        <label class="field">
+          <span>Top N</span>
+          <input id="topn" type="number" min="1" max="50" value="10" />
+        </label>
+        <button type="submit" id="go">Generate</button>
+      </div>
+    </form>
+
+    <p id="status" role="status" aria-live="polite">Loading engine…</p>
+
+    <section id="results" hidden>
+      <h2>Results <span id="ipa"></span></h2>
+      <ol id="clues"></ol>
+    </section>
+
+    <p id="error" role="alert" hidden></p>
+  </main>
+  <script type="module" src="./app.js"></script>
+</body>
+</html>
